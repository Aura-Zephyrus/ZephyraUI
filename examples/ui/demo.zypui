<!-- demo 示例的结构声明（.zypui 组件模板）。

     这一份是 examples/demo.rs 里六个视图函数（toolbar / icons / content /
     src_crops / effects / status_bar）的结构逻辑翻译：「建哪些节点、发哪些
     分类名、key 是什么」全部搬到这里；数据经 @绑定 从 Demo 来。外观值一个
     都没有 —— 全部在 demo.zstyle / controls.zstyle。

     类序即 dump 序：每个 class 属性的词序与 Rust 版 style_names() 逐一
     对齐。两处必须同改。

     惯例（与 gallery/shell.zypui 一致）：
     - 数据驱动列表（按钮、样张、裁剪区……）逐项状态用 hover(key) /
       press(key) 显式给 —— for 循环项不是组件实例，没有「当前 key」。
     - 结构值（滤镜链、混合模式）走 Val::Raw 透传，表达式语言没有字面量。
     - NOTE / Z_INDEX 是宿主自定义属性键，模板写不了 —— 在 Rust 侧
       view() 补挂（键的真相在宿主手里，这正是 prop_key 文档说的分工）。 -->

<!-- 一个效果样本：深色底板 + 半透明色块，色块带自己的滤镜 / 混合模式。
     三层而不是两层：底板是「目标」，滤镜与混合模式挂在样本上 ——
     涂在同一节点上后一次会覆盖前一次，两个模式的对比度就掉了。 -->
<component name="FxSwatch" params="id caption fill filter blend">
  <container key="{id}" class="fx">
    <container key="backdrop" class="backdrop">
      <container key="swatch" filter="{filter}" blend="{blend}" class="swatch {fill}"/>
    </container>
    <text key="caption" text="{caption}" class="caption"/>
  </container>
</component>

<page name="Demo">
  <container key="root" class="root">

    <!-- 工具栏：8 个可交互按钮。名字即 key；名字长的用小一档字号
         （compact 判断是数据的，用哪一档是样式表的 Text.label.compact）。 -->
    <container key="toolbar" class="toolbar">
      <for var="b" list="@buttons">
        <control key="{b.name}" interactive="true" class="{press(b.name) ? 'pressed'}">
          <container key="glyph" icon="{b.name}" class="glyph {press(b.name) ? 'pressed'} {!press(b.name) && hover(b.name) ? 'hovered'}"/>
          <text key="label" text="{b.name}" class="label {press(b.name) ? 'pressed'} {!press(b.name) && hover(b.name) ? 'hovered'} {b.compact ? 'compact'}"/>
        </control>
      </for>
    </container>

    <!-- 图像内容区：4 张真实纹理。名字即 key，注册时同名对上。 -->
    <container key="icons" class="icon-row">
      <for var="n" list="@icons">
        <image key="{n}" texture="{n}" class="icon"/>
      </for>
    </container>

    <!-- 内容区：强调色面板 + 4 行真实文本。 -->
    <container key="content" class="content">
      <container key="hero" class="hero">
        <for var="l" list="@lines">
          <text key="{l.key}" text="{l.text}" class="hero-line"/>
        </for>
      </container>
    </container>

    <!-- uv 裁剪样例：同一张棋盘按不同区域裁剪（最后一项故意越界）。 -->
    <container key="src-crops" class="crop-row">
      <for var="c" list="@crops">
        <image key="{c.key}" texture="demo:checker" uv="{c.uv}" class="crop"/>
      </for>
    </container>

    <!-- 效果展台：模糊 / 投影 / 多级链 + 两个非默认混合模式。 -->
    <container key="effects" class="effects">
      <container key="effects-row" class="effects-row">
        <for var="e" list="@effects">
          <FxSwatch id="{e.id}" caption="{e.caption}" fill="{e.fill}" filter="{e.filter}" blend="{e.blend}"/>
        </for>
      </container>
    </container>

    <!-- 状态栏。右侧文字反映 hover 目标；有没有目标决定 .hovered 档字色。 -->
    <container key="status" class="status">
      <container key="focus" class="dot"/>
      <text key="hovered" text="{@hover_caption}" class="status-line {@has_hover ? 'hovered'}"/>
    </container>

  </container>
</page>
