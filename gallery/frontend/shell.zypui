<!-- gallery 应用外壳与页面的结构声明（.zypui 组件模板），统一放在 frontend/。

     这一份是 frontend/app/shell.rs 与 frontend/app/pages/*.rs 的结构逻辑翻译：
     「建哪些节点、发哪些分类名、key 是什么」全部搬到这里；状态经 @绑定
     从 Gallery 来，文案走 tr('…')。外观值一个都没有 —— 全部在 .zstyle。

     类序即 dump 序：每个 class 属性的词序与 Rust 版 style_names() 逐一
     对齐（parity 对照的另一半）。两处必须同改。

     惯例（与 ui/controls.zypui 一致）：
     - 交互态只住组件模板里；实例 key 是 hover/press 基准 —— 页面控件
       的 key 就是 Gallery::click 的 key，两侧天然同一份。
     - 数据驱动列表的逐项状态用 hover(key) / press(key) 显式给。
     - 数据表（菜单条目、日历格、语言段……）由宿主绑定提供（Rec 数组）。 -->

<!-- ───────────────────────── 页面编排助手 ───────────────────────── -->

<!-- 一页的根容器：key + page-* 间距分类名。每个页面组件的根都是它。 -->
<component name="PageRoot" params="id cls">
  <container key="{id}" class="{cls}">
    <children/>
  </container>
</component>

<!-- 一个分区：标题 + 内容。 -->
<component name="Section" params="id title">
  <container key="{id}" class="section">
    <TextLabel key="section-title" text="{title}" level="text-body-strong"/>
    <container key="section-body" class="section-body">
      <children/>
    </container>
  </container>
</component>

<!-- 控件的一行样例：左标签、右控件。label 同时是三处 key（与 Rust 版
     demo() 同形：demo-row / demo-label / demo-slot 同名）。 -->
<component name="DemoRow" params="label">
  <container key="{label}" class="demo-row">
    <text key="{label}" text="{label}" class="demo-label"/>
    <container key="{label}" class="demo-slot">
      <children/>
    </container>
  </container>
</component>

<!-- ───────────────────────── 指南层（六章） ───────────────────────── -->

<component name="PageGuide">
  <PageRoot key="guide" cls="page-guide">
    <TextLabel key="guide-blurb" text="{tr('ui.click-the-button-the-count-goes-up-that-is-the-whole-pipeline')}" level="text-body"/>
    <DemoRow label="{tr('ui.counter')}">
      <Button key="guide-inc" label_key="ui.click-me" variant="accent"/>
    </DemoRow>
    <text key="guide-count" text="{@cnt_text}" class="text-title"/>
  </PageRoot>
</component>

<component name="PageState">
  <PageRoot key="state" cls="page-state">
    <TextLabel key="state-blurb" text="{tr('ui.wired-controls-change-state-on-click-display-only-controls-dont-thats-a-core-boundary-not-a-bug')}" level="text-body"/>
    <Section key="state-wired" title="{tr('ui.wired-to-state')}">
      <DemoRow label="{tr('ui.checkbox')}">
        <CheckBox key="state-check" label_key="ui.check.toggle-me" state="{@demo_check}"/>
      </DemoRow>
    </Section>
  </PageRoot>
</component>

<component name="PageStyling">
  <PageRoot key="styling" cls="page-styling">
    <TextLabel key="styling-blurb" text="{tr('ui.appearance-lives-in-zstyle-source-sends-keys-and-class-names-only-no-colors-no-sizes')}" level="text-body"/>
    <Section key="styling-tokens" title="{tr('ui.colors-come-from-theme-tokens')}">
      <DemoRow label="{tr('ui.token-colored-text')}">
        <TextLabel key="styling-note" text="{tr('ui.this-color-is-content-secondary')}" level="styling-note"/>
      </DemoRow>
    </Section>
    <Section key="styling-classes" title="{tr('ui.class-names-are-selectors')}">
      <DemoRow label="{tr('ui.primary')}">
        <Button key="act:style-primary" label_key="ui.primary" variant="accent"/>
      </DemoRow>
      <DemoRow label="{tr('ui.subtle')}">
        <Button key="act:style-subtle" label_key="ui.subtle" variant="subtle"/>
      </DemoRow>
      <DemoRow label="{tr('ui.standard')}">
        <Button key="act:style-standard" label_key="ui.standard" variant="standard"/>
      </DemoRow>
    </Section>
    <Section key="styling-layout" title="{tr('ui.layout-affecting-properties')}">
      <DemoRow label="{tr('ui.spacing-demo')}">
        <TextLabel key="styling-layout-note" text="{tr('ui.spacing-is-declared-affects-layout-so-color-only-changes-skip-relayout')}" level="text-caption"/>
      </DemoRow>
    </Section>
  </PageRoot>
</component>

<component name="PageLayout">
  <PageRoot key="layout" cls="page-layout">
    <TextLabel key="layout-blurb" text="{tr('ui.flex-rows-that-grow-and-wrap-and-the-one-boundary-that-is-still-real-no-scroll')}" level="text-body"/>
    <Section key="layout-flex" title="{tr('ui.flexbox-rows-that-grow-and-wrap')}">
      <DemoRow label="{tr('ui.flex-grow-1-fills-the-row-and-flex-wrap-packs-items-into-lines')}">
        <PageRoot key="fx-grow-demo" cls="fx-row">
          <container key="fx-fixed" class="fx-cell">
            <TextLabel key="fx-fixed-t" text="{tr('ui.fixed')}" level="text-caption"/>
          </container>
          <container key="fx-grow-cell" class="fx-grow">
            <TextLabel key="fx-grow-t" text="{tr('ui.grows')}" level="text-caption"/>
          </container>
        </PageRoot>
        <PageRoot key="fx-wrap-demo" cls="fx-wrap">
          <container key="fx-w1" class="fx-cell"/>
          <container key="fx-w2" class="fx-cell"/>
          <container key="fx-w3" class="fx-cell"/>
          <container key="fx-w4" class="fx-cell"/>
          <container key="fx-w5" class="fx-cell"/>
          <container key="fx-w6" class="fx-cell"/>
        </PageRoot>
      </DemoRow>
    </Section>
    <Section key="layout-breakpoints" title="{tr('ui.breakpoints-small-medium-large')}">
      <DemoRow label="{tr('ui.current-breakpoint')}">
        <TextLabel key="layout-bp" text="{@bp_text}" level="text-body-strong"/>
      </DemoRow>
    </Section>
    <Section key="layout-touch" title="{tr('ui.touch-targets-need-44-epx')}">
      <DemoRow label="{tr('ui.44-epx-correct')}">
        <Button key="act:touch-ok" label_key="ui.big-enough" variant="standard"/>
      </DemoRow>
      <DemoRow label="{tr('ui.28-epx-too-small')}">
        <RoundButton key="act:touch-bad" label_key="ui.tiny"/>
      </DemoRow>
    </Section>
  </PageRoot>
</component>

<component name="PageTheme">
  <PageRoot key="theme" cls="page-theme">
    <TextLabel key="theme-blurb" text="{tr('ui.theme-is-an-intent-not-a-reference-language-negotiates-from-system-prefs-then-manual-choice-wins')}" level="text-body"/>
    <Section key="theme-i18n" title="{tr('ui.language-en-zh-hans-ja')}">
      <DemoRow label="English">
        <PillButton key="lang:en" label="English" checked="{@lang == 0}"/>
      </DemoRow>
      <DemoRow label="中文">
        <PillButton key="lang:zh-Hans" label="中文" checked="{@lang == 1}"/>
      </DemoRow>
      <DemoRow label="日本語">
        <PillButton key="lang:ja" label="日本語" checked="{@lang == 2}"/>
      </DemoRow>
    </Section>
    <Section key="theme-current" title="{tr('ui.current-locale')}">
      <DemoRow label="{tr('ui.you-are-here')}">
        <TextLabel key="theme-locale" text="{@locale_name}" level="text-body-strong"/>
      </DemoRow>
    </Section>
  </PageRoot>
</component>

<component name="PageTesting">
  <PageRoot key="testing" cls="page-testing">
    <TextLabel key="testing-blurb" text="{tr('ui.three-layers-of-self-verification-from-fastest-to-slowest-each-guards-a-different-class-of-silent-failure')}" level="text-body"/>
    <Section key="testing-current" title="{tr('ui.current-state')}">
      <DemoRow label="{tr('ui.route')}">
        <TextLabel key="testing-route" text="{@route}" level="text-body"/>
      </DemoRow>
      <DemoRow label="{tr('ui.language')}">
        <TextLabel key="testing-lang" text="{@locale_name}" level="text-body"/>
      </DemoRow>
      <DemoRow label="{tr('ui.theme')}">
        <TextLabel key="testing-theme" text="{@theme_text}" level="text-body"/>
      </DemoRow>
    </Section>
    <Section key="testing-zstyle" title="{tr('ui.1-stylesheet-syntax')}">
      <DemoRow label="{tr('ui.check-a-stylesheet')}">
        <TextLabel key="testing-zstyle-cmd" text="cargo run -p zstylec -- check pages.zstyle" level="text-caption"/>
      </DemoRow>
    </Section>
    <Section key="testing-dump" title="{tr('ui.2-cpu-raster-dump')}">
      <DemoRow label="{tr('ui.dump-current-route')}">
        <TextLabel key="testing-dump-cmd" text="cargo run -p zephyra-gallery --bin gallery -- --dump-cpu" level="text-caption"/>
      </DemoRow>
      <DemoRow label="{tr('ui.dump-a-specific-route')}">
        <TextLabel key="testing-dump-route" text="  --route reference --lang zh-Hans" level="text-caption"/>
      </DemoRow>
      <DemoRow label="{tr('ui.dump-one-reference-family')}">
        <TextLabel key="testing-dump-family" text="  --family 3   # --list-families 列合法值" level="text-caption"/>
      </DemoRow>
    </Section>
    <Section key="testing-gates" title="{tr('ui.3-tree-level-gates')}">
      <DemoRow label="{tr('ui.run-all-gallery-gates')}">
        <TextLabel key="testing-gates-cmd" text="cargo test -p zephyra-gallery" level="text-caption"/>
      </DemoRow>
      <DemoRow label="{tr('ui.what-they-guard')}">
        <TextLabel key="testing-gates-what" text="{tr('ui.style-tokens-dead-rules-hit-test-breakpoints-no-appearance-in-source')}" level="text-caption"/>
      </DemoRow>
    </Section>
    <Section key="testing-try" title="{tr('ui.try-it-switch-language-same-state-as-lang')}">
      <DemoRow label="{tr('ui.language')}">
        <for var="e" index="i" list="@langs">
          <PillButton key="{e.id}" label="{e.label}" checked="{@lang == i}"/>
        </for>
      </DemoRow>
    </Section>
  </PageRoot>
</component>

<!-- ───────────────────────── 参考层（两族） ───────────────────────── -->

<component name="PageReference">
  <PageRoot key="reference" cls="page-reference">
    <TextLabel key="reference-blurb" text="{tr('ui.control-reference-pick-a-family-to-see-its-controls')}" level="text-body"/>
    <Segmented key="ref-family" items="{@ref_segs}" sel="{@ref_sel}"/>
    <if cond="@ref_family == 0">
      <PageButtons/>
    </if>
    <if cond="@ref_family == 1">
      <PageCheckbox/>
    </if>
  </PageRoot>
</component>

<component name="PageButtons">
  <PageRoot key="buttons" cls="page-buttons">
    <Section key="sec-btns" title="{tr('ui.button')}">
      <DemoRow label="{tr('ui.variants')}">
        <Button key="act:standard" label_key="ui.standard" variant="standard"/>
        <Button key="act:accent" label_key="ui.accent" variant="accent"/>
        <Button key="act:subtle" label_key="ui.subtle" variant="subtle"/>
      </DemoRow>
      <DemoRow label="{tr('ui.with-icon-round')}">
        <Button key="act:send" label_key="ui.send" icon="pen" variant="accent"/>
        <PillButton key="pill-a" label_key="ui.pill" icon="star" checked="{@pill_on}"/>
        <RoundButton key="round-a" label="" icon="chevron-up"/>
        <RoundButton key="round-b" label="" icon="close" checked="{true}"/>
      </DemoRow>
      <DemoRow label="{tr('ui.materials')}">
        <Button key="act:solid" label_key="ui.solid" variant="standard"/>
        <Button key="act:frosted" label_key="ui.frosted" variant="standard" material="frosted"/>
        <Button key="act:glass" label_key="ui.glass" variant="subtle" material="glass"/>
      </DemoRow>
    </Section>
  </PageRoot>
</component>

<component name="PageCheckbox">
  <PageRoot key="checkbox" cls="page-checkbox">
    <Section key="sec-check" title="{tr('ui.checkbox')}">
      <DemoRow label="{tr('ui.multiple')}">
        <CheckBoxGroup gkey="group:checks" label_key="{@check_group_header_key}" items="{@check_group_items}" state="{@check_group_state}"/>
      </DemoRow>
    </Section>
  </PageRoot>
</component>

<!-- ───────────────────────── 材质专区（与液态玻璃合并为一页） ───────────────────────── -->

<!-- 材质与玻璃**同页**：材质专区讲「三种表面长什么样」，液态玻璃讲
     「折射参数怎么调」。两件事共用**同一块照片板** —— 材质样板与玻璃块
     都浮在同一张山上，于是「实心 / 磨砂 / 玻璃」的差别和「薄 / 普通 / 厚」
     的差别是**同一张照片**上的两种读法，不用在两张图之间来回对照。
     照片挂在**板自己**身上（.zstyle 的 image-texture），因为它是所有子项
     背后必须先画进去的东西 —— 折射与磨砂读的就是那一份。 -->
<component name="PageMaterials">
  <PageRoot key="materials" cls="page-materials">
    <TextLabel key="materials-blurb" text="{tr('ui.materials-on-a-real-photo')}" level="text-body"/>
    <Section key="sec-materials" title="{tr('ui.materials-and-liquid-glass')}">
      <GlassParams/>
      <MaterialBoard/>
    </Section>
  </PageRoot>
</component>

<!-- 参数面板：四组 `[−] 名称 值 [+]`。数据（标签 / 步进键 / 当前值文本）
     由宿主绑定 @glass_params 逐帧给。 -->
<component name="GlassParams">
  <PageRoot key="glass-params" cls="glass-params">
    <for var="p" list="@glass_params">
      <PageRoot key="cell" cls="glass-param">
        <TextLabel key="{p.label}" text="{p.label}" level="glass-param-label"/>
        <RoundButton key="{p.dec}" label="-"/>
        <TextLabel key="v" text="{p.value}" level="glass-param-value"/>
        <RoundButton key="{p.inc}" label="+"/>
      </PageRoot>
    </for>
  </PageRoot>
</component>

<!-- 照片板：上排三块材质样板，下排三块玻璃块。
     板自己的 image-texture 是那张照片（见 pages.zstyle 的 .material-board），
     所以这里**没有**背景元素 —— 板就是背景。 -->
<component name="MaterialBoard">
  <PageRoot key="material-board" cls="material-board">
    <MaterialSwatches/>
    <GlassPanes/>
  </PageRoot>
</component>

<!-- 材质样板行：实心 / 磨砂 / 液态玻璃。
     材质种类是**外观**（.zstyle 的分类名 material-solid / material-frosted /
     material-glass），模板只负责摆位置 —— 外观不进模板是本仓的规矩。 -->
<component name="MaterialSwatches">
  <PageRoot key="material-swatches" cls="material-swatches">
    <container key="swatch:solid" class="material-swatch material-solid">
      <container key="chip:solid" class="photo-chip">
        <TextLabel key="sw:solid" text="{tr('ui.solid')}" level="photo-chip-text"/>
      </container>
    </container>
    <container key="swatch:frosted" class="material-swatch material-frosted">
      <container key="chip:frosted" class="photo-chip">
        <TextLabel key="sw:frosted" text="{tr('ui.frosted')}" level="photo-chip-text"/>
      </container>
    </container>
    <container key="swatch:glass" class="material-swatch material-glass">
      <container key="chip:glass" class="photo-chip">
        <TextLabel key="sw:glass" text="{tr('ui.glass')}" level="photo-chip-text"/>
      </container>
    </container>
  </PageRoot>
</component>

<!-- 玻璃块行：薄 / 普通 / 厚。三块共用面板调的那一组参数，只有**厚度**不同
     （偏移见 app/glass.rs 的 PANE_THICKNESS_OFFSETS）—— 三个标题才名副其实。
     滤镜是结构值（Val::Raw 透传），由宿主逐帧算。 -->
<component name="GlassPanes">
  <PageRoot key="glass-panes" cls="glass-panes">
    <PageRoot key="cell" cls="glass-cell">
      <container key="glass:a" filter="{@glass_filter_0}" class="glass-pane"/>
      <container key="gt:a" class="photo-chip">
        <TextLabel key="gt:a" text="{tr('ui.thin')}" level="glass-title"/>
      </container>
    </PageRoot>
    <PageRoot key="cell" cls="glass-cell">
      <container key="glass:b" filter="{@glass_filter_1}" class="glass-pane"/>
      <container key="gt:b" class="photo-chip">
        <TextLabel key="gt:b" text="{tr('ui.normal')}" level="glass-title"/>
      </container>
    </PageRoot>
    <PageRoot key="cell" cls="glass-cell">
      <container key="glass:c" filter="{@glass_filter_2}" class="glass-pane"/>
      <container key="gt:c" class="photo-chip">
        <TextLabel key="gt:c" text="{tr('ui.thick')}" level="glass-title"/>
      </container>
    </PageRoot>
  </PageRoot>
</component>

<!-- ───────────────────────── 整窗 ───────────────────────── -->
<!-- shell::window 的翻译：标题栏 + 主体（导航 + 内容卡）。page 的 key 上
     挂 enter-* 入场档；route 分发用 8 个 if（与 PAGES 表对齐）。 -->

<page name="Window">
  <container key="window" class="window">
    <container key="titlebar" class="titlebar {@mica ? 'mica' : ''}">
      <TextLabel key="app-title" text="{tr('ui.zephyraui-gallery')}" level="text-body-strong"/>
      <container key="search" class="search">
        <container key="search-icon" icon="search" class="search-icon"/>
        <TextLabel key="search-hint" text="{tr('ui.search-controls-and-samples')}" level="text-caption"/>
      </container>
      <container key="caption" class="caption-bar">
        <for var="c" list="@caps">
          <control key="{c.key}" interactive="true" class="caption-btn {c.close ? 'close' : ''} {press(c.key) ? 'pressed' : (hover(c.key) ? 'hovered' : '')}">
            <container key="icon" icon="{c.icon}" class="caption-icon"/>
          </control>
        </for>
      </container>
    </container>
    <container key="body" class="body">
      <container key="nav" class="nav-pane {@compact ? 'compact' : ''}">
        <for var="r" list="@routes">
          <NavItem key="{r.id}" label="{r.label}" icon="{r.icon}" selected="{r.id == @route}" compact="{@compact}"/>
        </for>
      </container>
      <container key="content" class="content-card">
        <container key="header" class="page-header">
          <container key="header-title" class="header-title">
            <TextLabel key="page-title" text="{@route_title}" level="text-title"/>
            <InfoBadge key="page-badge" text="12" severity="info" solid="{true}"/>
          </container>
          <container key="header-tools" class="header-tools">
            <TextLabel key="last-action" text="{@last_action}" level="text-caption"/>
            <ToolButton key="theme-toggle" icon="light"/>
            <Button key="act:feedback" label_key="action.feedback" icon="bell" variant="subtle"/>
          </container>
        </container>
        <container key="page" class="page {@enter_class}">
          <if cond="@route == 'guide'">
            <PageGuide/>
          </if>
          <if cond="@route == 'state'">
            <PageState/>
          </if>
          <if cond="@route == 'styling'">
            <PageStyling/>
          </if>
          <if cond="@route == 'layout'">
            <PageLayout/>
          </if>
          <if cond="@route == 'theme'">
            <PageTheme/>
          </if>
          <if cond="@route == 'testing'">
            <PageTesting/>
          </if>
          <if cond="@route == 'reference'">
            <PageReference/>
          </if>
          <if cond="@route == 'materials'">
            <PageMaterials/>
          </if>
        </container>
      </container>
    </container>
  </container>
</page>
