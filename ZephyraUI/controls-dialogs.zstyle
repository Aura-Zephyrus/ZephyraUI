/* AcrylicCard、RoundedCornerOverlay、Dialog、DatePicker、TimePicker
 * —— Apple HIG 度量。
 *
 * 对话框圆角 14px，padding 24px。
 */

/* ---- AcrylicCard ---- */

box.acrylic-card {
    direction: vertical;
    spacing: 10px;
    padding: 18px;
    width: 280px;
    corner-radius: 19.2px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

/* ---- RoundedCornerOverlay ---- */

box.corner-overlay {
    direction: vertical;
    spacing: 10px;
    padding: 18px;
    width: 280px;
    background: transparent;
    border-width: 1px;
    border-color: @card_border;
}

box.corner-overlay.r7 {
    corner-radius: 19.2px;
    corner-shape: superellipse(1.5);
}

box.corner-overlay.r3 {
    corner-radius: 9.6px;
    corner-shape: superellipse(1.5);
}

/* ---- Dialog ---- */

box.dialog {
    direction: vertical;
    spacing: 14px;
    padding: 28px;
    width: 440px;
    corner-radius: 22.4px;
    corner-shape: superellipse(1.5);
    background: @surface_alt;
    border-width: 1px;
    border-color: @card_border;
}

text.dialog-title {
    text-size: 22px;
    text-color: @content;
}

text.dialog-text {
    text-size: 15px;
    text-color: @content_secondary;
}

box.dialog-buttons {
    direction: horizontal;
    main-align: end;
    spacing: 10px;
}

/* ---- DatePicker ---- */

box.date-picker {
    direction: vertical;
    spacing: 6px;
    padding: 14px;
    width: 320px;
    corner-radius: 16px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

box.dp-heads {
    direction: horizontal;
    spacing: 6px;
}

text.dp-head {
    text-size: 13px;
    text-color: @content_secondary;
}

box.dp-row {
    direction: horizontal;
    spacing: 6px;
}

box.dp-cell {
    width: 38px;
    height: 38px;
    direction: horizontal;
    main-align: center;
    cross-align: center;
}

box.dp-cell.hovered .dp-day {
    background: @control_secondary;
}

box.dp-cell.pressed .dp-day {
    background: @control_tertiary;
}

box.dp-day {
    width: 34px;
    height: 34px;
    corner-radius: 158.4px;
    corner-shape: superellipse(1.5);
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: transparent;
}

box.dp-day.selected {
    background: @accent_fill;
}

text.dp-day-label {
    text-size: 13px;
    text-color: @content;
}

text.dp-day-label.selected {
    text-color: @on_accent_fill;
}

/* ---- TimePicker ---- */

box.time-picker {
    direction: horizontal;
    spacing: 14px;
    padding: 14px;
    corner-radius: 16px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

box.tp-col {
    direction: vertical;
    spacing: 4px;
}

box.tp-item {
    width: 68px;
    height: 34px;
    padding: 10px;
    corner-radius: 9.6px;
    corner-shape: superellipse(1.5);
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: transparent;
}

box.tp-item.hovered {
    background: @control_secondary;
}

box.tp-item.pressed {
    background: @control_tertiary;
}

box.tp-item.selected {
    background: @accent_fill;
}

text.tp-label {
    text-size: 14px;
    text-color: @content;
}

text.tp-label.selected {
    text-color: @on_accent_fill;
}
