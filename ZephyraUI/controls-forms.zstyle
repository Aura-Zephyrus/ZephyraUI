/* RoundButton、Hyperlink、DropDownButton、ComboBox、SpinBox、ColorPicker
 * —— Apple HIG 度量。
 *
 * 表单控件高 36px，圆角 8px。
 */

/* ---- RoundButton（正圆 / 全圆角） ---- */

control.round {
    width: 44px;
    height: 44px;
    corner-radius: 158.4px;
    corner-shape: superellipse(1.5);
    padding: 8px;
    direction: horizontal;
    main-align: center;
    cross-align: center;
    spacing: 10px;
    background: @control_tertiary;
    border-width: 1px;
    border-color: @control_border;
}

control.round.hovered {
    background: @control_secondary;
    border-color: @control_border_strong;
}

control.round.pressed {
    background: @control_tertiary;
}

control.round.checked {
    background: @accent_fill;
    border-color: @accent_fill;
}

box.round-icon {
    width: 18px;
    height: 18px;
    icon-color: @content;
}

box.round-icon.checked {
    icon-color: @on_accent_fill;
}

text.round-label {
    text-size: 14px;
    text-color: @content;
}

text.round-label.checked {
    text-color: @on_accent_fill;
}

/* ---- Hyperlink（accent 字 + 下划线） ---- */

control.hyperlink {
    direction: vertical;
    cross-align: stretch;
    spacing: 4px;
    padding: 4px;
}

text.hyperlink-label {
    text-size: 15px;
    text-color: @accent_fill;
}

/* 访问过的链接：次要文字色（RinUI Hyperlink 的 flat highlighted 语义）。 */
text.hyperlink-label.visited {
    text-color: @content_secondary;
}

box.link-underline {
    height: 1px;
    background: @accent_fill;
}

/* ---- DropDownButton ---- */

control.drop-down {
    direction: horizontal;
    main-align: start;
    cross-align: center;
    spacing: 10px;
    padding: 10px;
    width: 72px;
    height: 36px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    background: @control_fill;
    border-width: 1px;
    border-color: @control_border;
}

control.drop-down.hovered {
    background: @control_fill_hover;
    border-color: @control_border_strong;
}

control.drop-down.pressed {
    background: @control_fill_pressed;
}

control.drop-down.open {
    background: @control_secondary;
}

text.dd-label {
    text-size: 15px;
    text-color: @content;
}

box.dd-icon {
    width: 18px;
    height: 18px;
    icon-color: @content_secondary;
}

box.dd-chevron {
    width: 14px;
    height: 14px;
    icon-color: @content_secondary;
}

/* ---- ComboBox ---- */

control.combo-box {
    direction: horizontal;
    main-align: space-between;
    cross-align: center;
    spacing: 10px;
    padding: 10px;
    height: 36px;
    width: 220px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    background: @control_fill;
    border-width: 1px;
    border-color: @control_border;
}

control.combo-box.hovered {
    background: @control_fill_hover;
}

control.combo-box.pressed {
    background: @control_fill_pressed;
}

text.combo-value {
    text-size: 15px;
    text-color: @content;
}

box.combo-chevron {
    width: 14px;
    height: 14px;
    icon-color: @content_secondary;
}

/* ---- SpinBox ---- */

control.spin-box {
    direction: horizontal;
    /* 数字贴左、上下按钮贴右（Fluent NumberBox），中间留白由 space-between 撑开。 */
    main-align: space-between;
    cross-align: center;
    spacing: 8px;
    padding: 6px;
    height: 36px;
    width: 180px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    background: @control_fill;
    border-width: 1px;
    border-color: @control_border;
}

control.spin-box.hovered {
    background: @control_fill_hover;
}

text.spin-value {
    text-size: 15px;
    text-color: @content;
}

/* 上下按钮竖排：两颗 16px 的小方块，上/下箭头各占一格。 */
box.spin-steps {
    direction: vertical;
    spacing: 2px;
    width: 22px;
}

control.spin-step {
    width: 22px;
    height: 13px;
    corner-radius: 5px;
    corner-shape: superellipse(1.5);
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: @control_secondary;
}

control.spin-step.hovered {
    background: @control_strong;
}

control.spin-step.pressed {
    background: @accent_fill;
}

box.spin-step-icon {
    width: 10px;
    height: 10px;
    icon-color: @content;
}

/* ---- ColorPicker ---- */

box.color-picker {
    direction: vertical;
    spacing: 10px;
}

/* 已点过一次：轻微降透明度，让「点了已选中的色块」在树里也有状态变化。 */
box.color-picker.tapped {
    opacity: 0.98;
}

box.swatch-row {
    direction: horizontal;
    spacing: 8px;
}

box.swatch {
    width: 28px;
    height: 28px;
    corner-radius: 9.6px;
    corner-shape: superellipse(1.5);
    background: @control_fill;
    border-width: 1px;
    border-color: @card_border;
}

box.swatch.hovered {
    border-width: 2px;
    border-color: @control_border_strong;
}

box.swatch.pressed {
    border-width: 2px;
    border-color: @accent_fill;
    opacity: 0.8;
}

box.swatch.selected {
    border-width: 2px;
    border-color: @content;
}

/* 16 个默认色格。颜色是字面量，在样式表里而不是源码里。 */
box.sw-0 {
    background: #e81123;
}
box.sw-1 {
    background: #ea5800;
}
box.sw-2 {
    background: #fff100;
}
box.sw-3 {
    background: #00cc6a;
}
box.sw-4 {
    background: #00b7c3;
}
box.sw-5 {
    background: #0078d4;
}
box.sw-6 {
    background: #6b69d6;
}
box.sw-7 {
    background: #b146c2;
}
box.sw-8 {
    background: #e3008c;
}
box.sw-9 {
    background: #8a8886;
}
box.sw-10 {
    background: #69797e;
}
box.sw-11 {
    background: #4a5459;
}
box.sw-12 {
    background: #107c10;
}
box.sw-13 {
    background: #016393;
}
box.sw-14 {
    background: #881798;
}
box.sw-15 {
    background: #5c2e91;
}

/* Liquid/材质变体：玻璃时背景/滤镜由宿主绑定驱动（blur+lens），静态背景置透明。 */
control.drop-down.glass {
    background: transparent;
    border-color: #ffffff66;
}

control.drop-down.solid {
    opacity: 1;
}

control.drop-down.focused {
    border-color: @focus_ring;
    border-width: 2px;
}

control.drop-down.disabled {
    opacity: 0.45;
}

box.dd-chevron.open {
    icon-color: @content;
}

/* ---- DropDown morph（按钮直接变形为菜单，同一控件） ---- */

/* 头部只按内容取高（约 18px），由父级 `cross-align` 在按钮内容区垂直居中。
 * 之前写死 `height:36px`，叠加 `padding:10px` 后比 36px 的按钮还高，
 * 文字被顶到按钮下沿（截图里“选项”贴底）—— 去掉固定高度即可居中。 */
box.dd-head {
    direction: horizontal;
    main-align: start;
    cross-align: center;
    spacing: 8px;
}

box.dd-menu-body {
    direction: vertical;
    spacing: 0px;
    cross-align: stretch;
}

/* 形变态：几何钩子（整段形变期间存在），不在此强制改布局方向，避免首帧跳动。
 * `cross-align: start` 让按钮头在盒子长高时仍钉在左上角（不随高度上下漂）。 */
control.drop-down.morph-menu {
    spacing: 0px;
    cross-align: start;
}

/* 菜单项显示时再切纵向布局。 */
control.drop-down.menu-layout {
    direction: vertical;
    main-align: start;
    cross-align: stretch;
}

/* 按钮直接形变为菜单：保持在原按钮流位置（不写死 left/top），
 * 菜单覆盖在按钮上展开。玻璃向上展开由 translate-y 绑定配合高度完成。 */
control.drop-down.morph-menu.dd-morph {
    corner-shape: superellipse(1.5);
    background: @surface_alt;
    border-width: 1px;
    border-color: @card_border;
}

control.drop-down.morph-menu.dd-morph-glass {
    background: transparent;
}

control.drop-down.dd-morph {
    direction: vertical;
}
control.drop-down.dd-morph-solid {
    direction: vertical;
}
control.drop-down.dd-morph-glass {
    direction: vertical;
}
control.dd-morph {
    direction: vertical;
}

/* ---- 32 档：从原按钮形状原地连续形变为菜单 ---- */

