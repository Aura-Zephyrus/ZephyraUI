<!-- 控件层的结构声明（.zypui 组件模板）。

     本文件是节点树 / 分类名 / key / 资源引用的**唯一权威**（见
     docs/developer/syntax.md 的四所有权）。Rust 控件模块只持有状态值与流转
     规则；外观值一个都没有 —— 全部在 .zstyle；时钟归应用侧 driver。

     class 属性的词序**没有语义**：样式匹配按集合判定，门禁也按集合比对。

     惯例：
     - `press ? 'pressed' : (hover ? 'hovered' : '')` = state()（pressed 优先）。
     - 交互态只住组件模板里；实例 key（Use 的 key）是 hover/press 基准。
     - 数据驱动列表的逐项状态用 hover(key) / press(key) 显式给 key。
     - 可选图标位用 if cond="icon"：实参缺省即假。
     - 内置词 `key` = 当前实例 key（expander 家族「可点区域 = 实例 key」）。

     # 文案：控件只发 key，翻译在控件内部发生

     Button / PillButton / RoundButton / CheckBox / CheckBoxGroup 的文案有**两条通道**：

     - `label_key` —— **语义 key**（不是文案）。控件内部 `tr()` 翻译它。
       静态文案走这条：`<Button label_key="ui.ok"/>`。
     - `label` —— **已翻译的文案**。给动态文本（「删除 3 项」这种每帧不同的）
       用；静态文案不走这条（否则切语言时它不跟着变）。

     模板里择一：`text="{label_key ? tr(label_key) : label}"`。

     ⚠ 控件层**不发面向用户的文案** —— 本文件里 `text=` 的值一律是表达式，
     裸字面量会被门禁拦下（`gallery/tests/gates.rs`）。控件**自身语义**的
     文案（复选框组组头的「全选」）归 `ZephyraUI/src/i18n.rs`，自带三语言
     默认译文，应用可覆盖。 -->

<component name="Button" params="label label_key icon variant material">
  <control interactive="true" focusable="true" activatable="true" class="button {variant} {material} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused' : ''}">
    <if cond="icon">
      <box key="icon" icon="{icon}" class="{variant} {press ? 'pressed' : (hover ? 'hovered' : '')} btn-icon"/>
    </if>
    <text key="label" text="{label_key ? tr(label_key) : label}" class="{variant} {press ? 'pressed' : (hover ? 'hovered' : '')} btn-label"/>
  </control>
</component>

<!-- RinUI `ToggleButton.qml` ≡ Button + `checkable` + `highlighted: checked`。 -->
<component name="ToggleButton" params="label label_key checked">
  <control interactive="true" focusable="true" activatable="true" class="button {checked ? 'accent' : 'subtle'} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused' : ''}">
    <text key="label" text="{label_key ? tr(label_key) : label}" class="{checked ? 'accent' : 'subtle'} btn-label"/>
  </control>
</component>

<component name="ToolButton" params="icon highlighted">
  <control interactive="true" class="tool-button {highlighted ? 'highlighted' : ''} {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <box key="icon" icon="{icon}" class="{highlighted ? 'highlighted' : ''} {press ? 'pressed' : (hover ? 'hovered' : '')} tool-icon"/>
  </control>
</component>

<component name="PillButton" params="label label_key icon checked">
  <control interactive="true" class="pill {checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <if cond="icon">
      <box key="icon" icon="{icon}" class="{checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')} pill-icon"/>
    </if>
    <text key="label" text="{label_key ? tr(label_key) : label}" class="{checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')} pill-label"/>
  </control>
</component>

<component name="InfoBadge" params="text severity solid">
  <control class="badge {severity} {solid ? '' : 'outline'}">
    <text key="text" text="{text}" class="{severity} {solid ? '' : 'outline'} badge-text"/>
  </control>
</component>

<component name="DotBadge" params="severity">
  <box class="badge-dot {severity}"/>
</component>

<component name="Card" params="extra">
  <box class="card {extra}">
    <children/>
  </box>
</component>

<component name="SettingCard" params="title desc">
  <box class="setting-card">
    <box key="texts" class="setting-texts">
      <text key="title" text="{title}" class="setting-title"/>
      <text key="desc" text="{desc}" class="setting-desc"/>
    </box>
    <box key="control-slot" class="setting-control">
      <children/>
    </box>
  </box>
</component>

<component name="ClipCard" params="icon title desc">
  <box class="clip-card">
    <box key="icon" icon="{icon}" class="clip-icon"/>
    <box key="texts" class="clip-texts">
      <text key="title" text="{title}" class="clip-title"/>
      <text key="desc" text="{desc}" class="clip-desc"/>
    </box>
  </box>
</component>

<!-- 可点区域的 key 就是实例 key（内部名会同页撞名，见 card.rs 注释）。 -->
<component name="Expander" params="title expanded">
  <box class="expander">
    <box key="{key}" interactive="true" class="expander-header">
      <text key="title" text="{title}" class="expander-title"/>
      <box key="chevron" icon="chevron-down" class="expander-chevron {expanded ? 'open' : 'closed'}"/>
    </box>
    <box key="content" collapsed="{!expanded}" class="expander-content">
      <children/>
    </box>
  </box>
</component>

<component name="TextLabel" params="text level">
  <text text="{text}" class="{level}"/>
</component>

<component name="Caption" params="text">
  <text text="{text}" class="text-caption"/>
</component>

<!-- 复选框：`state` 是**状态分类词**（"" / "checked" / "indeterminate"），
     由宿主侧的 `zephyra_ui::CheckState::class_word()` 产出 —— 模板只是个
     管道，不认识「三态」是什么，状态语义与流转规则全在 Rust 侧。

     `tristate` 是**结构开关**（不是状态值）：三态框才带半选横杠那个节点。
     它是每个实例**固定**的，所以不产生「状态增删节点」的抖动。

     `disabled` 走 core 的 `props::DISABLED`：命中测试与键盘激活都认它。

     键盘可达：focusable 进 Tab 序、activatable 让 Space/Enter 触发点击
     （core 的 `ActivationState` 复用 pressed 通道，应用零改动）。 -->
<component name="CheckBox" params="label label_key state tristate disabled">
  <control interactive="true" focusable="true" activatable="true" disabled="{disabled}" class="check-box {state} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused'} {disabled ? 'disabled'}">
    <box key="indicator" class="check-indicator {state} {focused ? 'focused'}">
      <box key="mark" icon="check" class="check-mark {state}">
        <if cond="tristate">
          <box key="dash" class="check-dash {state}"/>
        </if>
      </box>
    </box>
    <text key="label" text="{label_key ? tr(label_key) : label}" class="{state} {press ? 'pressed' : (hover ? 'hovered' : '')} check-label"/>
  </control>
</component>

<!-- 复选框组：组头是三态的「全选 / 全部不选」，子项是两态的平铺一层。

     组头的 `state` 由宿主侧从子项**聚合派生**（不是单独存的）—— 存了两份
     真相就会出现「子项变了、组头忘了改」，而那种不一致在画面上看不出来。

     组头的 key 就是组 key（点组头 = 全选/全不选）；子项各自用 `e.id`
     作 key：点子项只改自己。

     ⚠ 组 key 走**实参** `gkey`，不走 Use 的 `key` 属性 —— 原因见下。

     # 为什么组 key 不能是 Use 的 key

     zypui 的「实例补丁」（`RootPatch`，见 `zypui/src/instantiate.rs`）会把
     Use 的 key 打在**组件体的第一个元素**上。若 `CheckBoxGroup` 的第一个
     元素就是外层容器，它会拿走组 key —— 于是「容器」与「组头那颗复选框」
     **同 key**。而按 key 找节点是**深度优先、第一个命中**（core 的
     `FocusState::write_state` / `ActivationState` 都这么找）。

     同 key 的后果不是「树上多了一个节点」，而是两个**功能**坏掉：

     - `FOCUSED` 写到外层容器上 → 焦点环画不到复选框上；
     - 容器没有 `ACTIVATABLE` → Space/Enter **闩不住** → 键盘切不动。

     这类失效在画面上完全看不出来（控件照常显示、鼠标照常能点），只有
     用键盘的时候才发现「这颗框按空格没反应」。

     所以组 key 改由实参 `gkey` 进来：组头那颗复选框的 key 就是 `gkey`
     （唯一、可聚焦、可激活），外层容器另用一个 `grp:` 前缀的装饰性 key。
     这与 `PageRoot` / `Section` 用 `id` 实参承载 key 是同一手法。

     ⚠ 本组件体内**不要用内置词 `key`**：Use 不带 key ⇒ 实例 key 不会推进，
     `{key}` 拿到的是**调用方**的实例 key。用 `{gkey}`。 -->
<component name="CheckBoxGroup" params="gkey label label_key items state">
  <box key="{'grp:' + gkey}" class="check-group">
    <CheckBox key="{gkey}" label="{label}" label_key="{label_key}" state="{state}" tristate="{true}"/>
    <box key="{'items:' + gkey}" class="check-group-items">
      <for var="e" index="i" list="items">
        <box key="{'grow:' + str(i)}" class="check-group-row">
          <box key="indent" class="check-indent"/>
          <CheckBox key="{e.id}" label="{e.label}" label_key="{e.label_key}" state="{e.state}" disabled="{e.disabled}"/>
        </box>
      </for>
    </box>
  </box>
</component>

<!-- 单选钮：两态的「挑一个」。
     `checked` 是**状态分类词**（"" / "checked"），由宿主侧的
     `zephyra_ui::RadioGroup::option_class_word()` 产出 —— 模板不认识
     「单选」是什么，状态语义与流转规则全在 Rust 侧。

     文案走**双通道**：`label_key` 是语义 key（控件内部 `tr()` 翻译），
     `label` 是已翻译的文案（动态文本用）。与 CheckBox 同纪律。

     键盘可达：focusable 进 Tab 序、activatable 让 Space/Enter 触发点击
     （core 的 `ActivationState` 复用 pressed 通道，应用零改动）。
     `disabled` 走 core 的 `props::DISABLED`：命中测试与键盘激活都认它。 -->
<component name="RadioButton" params="label label_key checked disabled">
  <control interactive="true" focusable="true" activatable="true" disabled="{disabled}" class="radio-box {checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused'} {disabled ? 'disabled'}">
    <box key="indicator" class="radio-indicator {checked ? 'checked'} {focused ? 'focused'}">
      <box key="mark" class="radio-dot {checked ? 'checked'}"/>
    </box>
    <text key="label" text="{label_key ? tr(label_key) : label}" class="{checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')} check-label"/>
  </control>
</component>

<!-- 开关：一比一复刻 iOS LiquidToggle（Apache-2.0，`E:\AndroidLiquidGlass` 的
     `LiquidToggle.kt` + `DampedDragAnimation.kt`；本仓的对应实现是
     `ZephyraUI/src/toggle.rs`，控制弹簧曲线与物理状态）。

     轨道 64×28（圆角 99 = capsule，内边距 2），把手 40×24（capsule），
     行程 20px。

     ⚠ `on` 这个状态分类词落在**控件自己**身上（不只是 `switch-track`
     子节点）—— 无障碍树按「元素自己的分类名」读开关状态，状态若只落在
     子节点上，屏读器读到的一直是「关」。

     `key="label"` 的文本子节点是**无障碍名**的来源（UIA 规则的既有约定）：
     没有它，开关在屏幕阅读器里是个没有名字的控件。

     把手 / 轨道的背板**全部走动态绑定**（结构值走 `Val::Raw` —— 与 filter /
     decoration 同一条路；knob_bg 是 `Color` 结构值）：

     - `knob_bg`：把手白罩 = `White @ (1 − press)`，按住时让出折射面；
     - `knob_filter`：`[BackdropBlur(8dp·(1−press)), Refraction(5dp·press,
       10dp·press, dispersion 0.2, ior 1.5)]`（原版 `blur(8dp·(1−p))` +
       `lens(5dp·p, 10dp·p, chromaticAberration = true)`）；
     - `knob_decoration`：`Decorations::control_with_progress(press)` ——
       高光 Ambient(宽/1.5, alpha = press) / 投影 Shadow(4dp, #000@0.05) 恒定 /
       内阴影 InnerShadow(4dp · press)。**装饰落在把手上**（原版 drawBackdrop
       挂 knob 上），不是整行。
     - `knob_x` = `fraction × 20px`；`knob_scale_x / knob_scale_y` 是两个独立的
       临界阻尼弹簧（ζ=1，ω=√250），无速度拉伸（已整体删除）。

     `animated` 原样作为分类词落在**轨道**上（与 `InfoBadge` 的 `severity` 同一
     手法）：调用方传 `"animated"` 时轨道带上这个词，
     `.switch-track.on.animated { main-align: start }` 把静态 `.on { end }`
     压掉 —— 两者必须互斥，否则位移叠加成双倍。
     - 不传这些 `knob_*` 值时属性不实例化（`as_f32` 失败或 Raw 类型不匹配 →
       按「没设」降级），把手退回静态 `main-align` 布局；轨道色始终由样式表
       `.switch-track` / `.on` 静态双类决定。
     `material`：`solid`（**默认**）= 把手位移走 250 ms「快入」tween、按压/缩放
       瞬变、不绑玻璃动态值；`glass` = 维持上述复刻（白罩 / 透镜 / 装饰，
       全由宿主绑定驱动）。`material` 只是分类词（落类 `.switch.solid` /
       `.switch.glass`）；玻璃效果不写在样式里——写在宿主绑定里。 -->
<component name="ToggleSwitch" params="label label_key checked disabled knob_x knob_scale_x knob_scale_y knob_bg knob_filter knob_decoration animated material">
  <control interactive="true" focusable="true" activatable="true" disabled="{disabled}" class="switch {checked ? 'on'} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused'} {disabled ? 'disabled'} {material}">
    <box key="track" class="switch-track {checked ? 'on'} {focused ? 'focused'} {disabled ? 'disabled'} {animated}">
      <box key="knob" translate-x="{knob_x}" scale-x="{knob_scale_x}" scale-y="{knob_scale_y}" background="{knob_bg}" filter="{knob_filter}" decoration="{knob_decoration}" class="switch-knob"/>
    </box>
    <text key="label" text="{label_key ? tr(label_key) : label}" class="{checked ? 'on'} {press ? 'pressed' : (hover ? 'hovered' : '')} switch-label"/>
  </control>
</component>

<!-- 滑块：一比一复刻 iOS/AndroidLiquidGlass `LiquidSlider`（Apache-2.0，
     `E:\AndroidLiquidGlass` 的 `LiquidSlider.kt` + `DampedDragAnimation.kt`；
     本仓模型 `ZephyraUI/src/slider.rs`）。

     轨道 240×6（capsule）、填充 6h 强调色、拇指 40×24（capsule），
     行程 = 轨道宽 × progress，拇指 translate-x 含原版 clamp（允许各超出 1/4 拇指宽）。

     原版语义（严格移植）：
     - value: `spring(1,1000,visibilityThreshold)` 逼近 targetValue；progress 派生填充/位移
     - 拖拽：delta = span*(dragAmount.x/trackWidth)，累加到 targetValue（coerce），
       `onDragStopped` 仅 didDrag 时提交 targetValue（宿主取 `take_committed_value`）
     - 点按轨道：`animateToValue(target)` = press→value 动画→等 2.5% 收敛→release
     - press: `spring(1,1000,0.001)`；scaleX/Y: 欠阻尼 `spring(0.6/0.7,250,0.001)`，pressedScale=1.5
     - `layerBlock` 速度形变：`scaleX /= 1-clamp(v/10*0.75,-0.2,0.2)`，`scaleY *= 1-clamp(v/10*0.25,-0.2,0.2)`
       （`velocity` 由 value 运动派生，`spring(0.5,300,vis*10)`）
     - 玻璃拇指：`blur(8*(1-press)) + lens(10*press,14*press)`、白罩 `White@(1-press)`、
       高光/投影/内阴影/装饰按 press（同 control_with_progress 形态），落在拇指上

     绑定均为结构/数值（`Val::Raw`/f32），与 ToggleSwitch 同路；不传则降级为静态。
     `material`：`solid`（默认）= 值/位移动画 + 按压瞬变、无玻璃动态；`glass` = 全套。
     已知缺口：原版 `CombinedBackdrop` 的轨道离屏采样进拇指（scale(lerp(2/3,1,p),lerp(0,1,p))）
     需第二条 slot 管线，本次不伪造。 -->
<component name="Slider" params="label label_key fill_w thumb_x thumb_scale_x thumb_scale_y thumb_bg thumb_filter thumb_decoration animated material disabled">
  <control interactive="true" focusable="true" activatable="true" disabled="{disabled}" class="slider {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused'} {disabled ? 'disabled'} {material}">
    <box key="track" class="slider-track {animated}">
      <box key="fill:slider" width="{fill_w}" class="slider-fill"/>
      <box key="thumb" translate-x="{thumb_x}" scale-x="{thumb_scale_x}" scale-y="{thumb_scale_y}" background="{thumb_bg}" filter="{thumb_filter}" decoration="{thumb_decoration}" class="slider-thumb"/>
    </box>
    <if cond="label">
      <text key="value" text="{label}" class="slider-value"/>
    </if>
  </control>
</component>

<component name="ProgressBar" params="value01 state">
  <control interactive="true" class="progress">
    <box key="fill:progress" width="{min(max(value01, 0.0), 1.0) * 240.0}" class="progress-fill {state}"/>
  </control>
</component>

<!-- 分段/列表/选择栏的逐项 hover/press 用 hover(key) 显式给。 -->
<component name="Segmented" params="items sel">
  <box class="segmented">
    <for var="e" list="items">
      <control key="{e.id}" interactive="true" class="seg-item {e.id == sel ? 'selected'} {press(e.id) ? 'pressed' : (hover(e.id) ? 'hovered' : '')}">
        <text key="label" text="{e.label}" class="{e.id == sel ? 'selected'} {press(e.id) ? 'pressed' : (hover(e.id) ? 'hovered' : '')} seg-label"/>
      </control>
    </for>
  </box>
</component>

<component name="NavItem" params="label icon selected compact">
  <control interactive="true" class="nav-item {selected ? 'selected'} {compact ? 'compact'} {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <box key="bar" class="nav-bar {selected ? 'selected'}"/>
    <box key="icon" icon="{icon}" class="{selected ? 'selected'} {compact ? 'compact'} {press ? 'pressed' : (hover ? 'hovered' : '')} nav-icon"/>
    <text key="label" text="{label}" collapsed="{compact}" class="{selected ? 'selected'} {compact ? 'compact'} {press ? 'pressed' : (hover ? 'hovered' : '')} nav-label"/>
  </control>
</component>

<component name="Menu" params="entries">
  <box class="menu">
    <for var="e" index="i" list="entries">
      <if cond="e.label == ''">
        <box key="{'msep:' + str(i)}" class="menu-separator"/>
        <else>
          <MenuItem key="{e.key}" label="{e.label}"/>
        </else>
      </if>
    </for>
  </box>
</component>

<component name="MenuItem" params="label checked arrow">
  <box interactive="true" class="menu-item {checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <box key="check" class="menu-check {checked ? 'checked'}"/>
    <text key="label" text="{label}" class="menu-item-label"/>
    <box key="arrow" icon="chevron-down" class="menu-arrow {arrow ? 'on'}"/>
  </box>
</component>

<!-- 顶级项：open 是展开项下标（-1 = 全收起）。 -->
<component name="MenuBar" params="labels open">
  <box class="menu-bar">
    <for var="lb" index="i" list="labels">
      <box key="{'bar:' + str(i)}" interactive="true" class="menu-bar-item {i == open ? 'open'}">
        <text key="label" text="{lb}" class="bar-item-label"/>
      </box>
    </for>
  </box>
</component>

<component name="NavSubItem" params="label icon selected">
  <control interactive="true" class="nav-sub {selected ? 'selected'} {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <box key="indent" class="nav-indent"/>
    <if cond="icon">
      <box key="icon" icon="{icon}" class="{selected ? 'selected'} {press ? 'pressed' : (hover ? 'hovered' : '')} sub-icon"/>
    </if>
    <text key="label" text="{label}" class="{selected ? 'selected'} {press ? 'pressed' : (hover ? 'hovered' : '')} sub-label"/>
  </control>
</component>

<component name="SelectorBar" params="items sel state">
  <box class="selector-bar {state}">
    <for var="e" list="items">
      <control key="{e.id}" interactive="true" class="selector-item {e.id == sel ? 'selected'} {press(e.id) ? 'pressed' : (hover(e.id) ? 'hovered' : '')}">
        <text key="label" text="{e.label}" class="{e.id == sel ? 'selected'} {press(e.id) ? 'pressed' : (hover(e.id) ? 'hovered' : '')} selector-label"/>
      </control>
    </for>
  </box>
</component>

<component name="ErrorPage" params="title message retry retry_key">
  <box class="error-page">
    <box key="top-gap" class="error-gap"/>
    <box key="icon" icon="close" class="error-icon"/>
    <text key="title" text="{title}" class="error-title"/>
    <text key="message" text="{message}" class="error-message"/>
    <Button key="{retry_key}" label="{retry}" variant="accent"/>
  </box>
</component>

<!-- RinUI `ProgressRing.qml`：Canvas 上一条线宽 6、圆端、从 12 点方向起画的圆弧，
     **没有文字标签**（数值在 RinUI 里由外部 SpinBox 显示）。这里用预生成的弧线帧
     图标表达不确定态的旋转；确定态是纯圆环 + 纯色描边。 -->
<component name="ProgressRing" params="value state show_value">
  <box key="{key}" interactive="true" class="progress-ring">
    <box key="ring" class="ring-track {state}">
    </box>
  </box>
</component>

<component name="InfoBar" params="title text severity closable">
  <box class="info-bar {severity}">
    <box key="bar-icon" icon="{severity == 'success' ? 'check' : (severity == 'caution' ? 'bell' : (severity == 'error' ? 'close' : 'bell'))}" class="bar-icon {severity}"/>
    <box key="texts" class="bar-texts">
      <text key="title" text="{title}" class="bar-title"/>
      <text key="text" text="{text}" class="bar-text"/>
    </box>
    <!-- collapsed 是「有则设 true」：closable 时不设该属性（与 Rust 版
         `if !closable { with(COLLAPSED, true) }` 同形，空 false 也是多余属性）。 -->
    <if cond="closable">
      <control key="bar:close" interactive="true" class="bar-close">
        <box key="icon" icon="close" class="bar-close-icon"/>
      </control>
      <else>
        <!-- 关掉后保留同 key 的节点（结构稳定），但换一个类名，让「点关闭」在
             树指纹里可见 —— 门禁 shape_fingerprint 只看 tag/key/class/text。 -->
        <control key="bar:close" interactive="true" collapsed="true" class="bar-close closed">
          <box key="icon" icon="close" class="bar-close-icon"/>
        </control>
      </else>
    </if>
  </box>
</component>

<component name="Toast" params="title text severity">
  <box class="toast {severity}">
    <box key="toast-icon" icon="{severity == 'success' ? 'check' : (severity == 'caution' ? 'bell' : (severity == 'error' ? 'close' : 'bell'))}" class="bar-icon {severity}"/>
    <box key="texts" class="bar-texts">
      <text key="title" text="{title}" class="{severity} bar-title"/>
      <text key="text" text="{text}" class="{severity} bar-text"/>
    </box>
  </box>
</component>

<!-- RinUI `ToolTip.qml`：默认由 hover 触发显隐；宿主把 `visible` 绑过来即可。 -->
<component name="ToolTip" params="text visible">
  <box collapsed="{!visible}" class="tool-tip">
    <text key="text" text="{text}" class="tip-text"/>
  </box>
</component>

<!-- 三颗点按 frame 轮换大小档（Rust 版 (i + 3 - frame % 3) % 3 展开）。 -->
<!-- RinUI `BusyIndicator.qml` 只有 11 行：继承 ProgressRing，state=Running、
     indeterminate=running。弧线顶点由宿主按连续相位每帧生成（Canvas 式路径动画）。 -->
<component name="BusyIndicator" params="path">
  <box class="busy">
    <box key="ring" path="{path}" class="busy-ring"/>
  </box>
</component>

<component name="PageIndicator" params="count current">
  <box class="page-indicator">
    <for var="i" list="range(count)">
      <!-- 每个点是可点控件：点第 i 个即切到第 i 页（RinUI `PageIndicator` 的 TapHandler）。 -->
      <control key="{'pip:' + str(i)}" interactive="true" class="pip {i == current ? 'selected'} {press('pip:' + str(i)) ? 'pressed' : (hover('pip:' + str(i)) ? 'hovered' : '')}"/>
    </for>
  </box>
</component>

<!-- 根类序 [round, round, …]：Rust 版 style("round") + 类表里的 "round"
     各出现一次 —— 忠实复刻现状，parity 对照按此。 -->
<component name="RoundButton" params="label label_key icon checked">
  <control interactive="true" class="round round {checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <if cond="icon">
      <box key="icon" icon="{icon}" class="round {checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')} round-icon"/>
    </if>
    <text key="label" text="{label_key ? tr(label_key) : label}" class="round {checked ? 'checked'} {press ? 'pressed' : (hover ? 'hovered' : '')} round-label"/>
  </control>
</component>

<component name="Hyperlink" params="text url visited">
  <control interactive="true" url="{url}" class="hyperlink {visited ? 'visited' : ''} {hover ? 'hovered' : ''}">
    <text key="label" text="{text}" class="{visited ? 'visited' : ''} {hover ? 'hovered' : ''} hyperlink-label"/>
    <box key="underline" class="{hover ? 'hovered' : ''} link-underline"/>
  </control>
</component>

<!-- 胶囊/液态按钮：一比一复刻 AndroidLiquidGlass `LiquidButton` + `InteractiveHighlight`
     （Apache-2.0，`E:\AndroidLiquidGlass`；模型 `ZephyraUI/src/liquid_button.rs`）。

     原版：Capsule 48h, padding-x 16, gap 8；
     `vibrancy()+blur(2dp)+lens(12dp,24dp)`；tint/surface 走 background；
     interactive layerBlock = press spring(0.5,300,.001) -> baseScale(1+4/h*p) +
     tanh 拖拽位移(maxOffset=min(w,h),k=0.05) + 方向性 scale；InteractiveHighlight
     径向着色器高光无直接等价（用 decoration 近似），vibrancy 无独立 filter（省略）。
     material=solid 时瞬变/无拖拽形变；glass=全套。 -->
<component name="LiquidButton" params="label label_key icon material disabled scale_x scale_y translate_x translate_y background filter decoration">
  <if cond="material == 'glass'">
    <control interactive="true" focusable="true" activatable="true" disabled="{disabled}" scale-x="{scale_x}" scale-y="{scale_y}" translate-x="{translate_x}" translate-y="{translate_y}" background="{background}" filter="{filter}" decoration="{decoration}" class="liquid-button {material} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused'} {disabled ? 'disabled'}">
      <if cond="icon">
        <box key="icon" icon="{icon}" class="liquid-btn-icon {material}"/>
      </if>
      <text key="label" text="{label_key ? tr(label_key) : label}" class="liquid-btn-label {material}"/>
    </control>
    <else>
      <control interactive="true" focusable="true" activatable="true" disabled="{disabled}" scale-x="{scale_x}" scale-y="{scale_y}" translate-x="{translate_x}" translate-y="{translate_y}" class="liquid-button {material} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused'} {disabled ? 'disabled'}">
        <if cond="icon">
          <box key="icon" icon="{icon}" class="liquid-btn-icon {material}"/>
        </if>
        <text key="label" text="{label_key ? tr(label_key) : label}" class="liquid-btn-label {material}"/>
      </control>
    </else>
  </if>
</component>

<!-- 下拉按钮：**同一个控件**直接变形为菜单（不额外加弹层元素）。
     `open` 控制形态/类；`show_items` 控制菜单项显隐（形变到位再揭示，避免文字溢出）；
     `extra_class` 供调用方定位。 -->
<component name="DropDownButton" params="label label_key icon open show_items logical_open material disabled entries extra_class scale_x scale_y translate_x translate_y background filter decoration">
  <if cond="material == 'glass'">
    <control interactive="true" focusable="true" activatable="true" disabled="{disabled}" scale-x="{scale_x}" scale-y="{scale_y}" translate-x="{translate_x}" translate-y="{translate_y}" background="{background}" filter="{filter}" decoration="{decoration}" class="drop-down drop-down {open ? 'open'} {open ? 'morph-menu'} {show_items ? 'menu-layout'} {material} dd-morph {material == 'glass' ? 'dd-morph-glass' : 'dd-morph-solid'} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused'} {disabled ? 'disabled'} {extra_class}">
      <if cond="!show_items">
        <box key="head" class="dd-head {open ? 'morphed'}">
          <if cond="icon">
            <box key="icon" icon="{icon}" class="dd-icon {material}"/>
          </if>
          <text key="label" text="{label_key ? tr(label_key) : label}" class="dd-label {material}"/>
          <box key="chevron" icon="{logical_open ? 'chevron-up' : 'chevron-down'}" class="dd-chevron {logical_open ? 'open'}"/>
        </box>
      </if>
      <if cond="show_items">
        <box key="menu-body" class="dd-menu-body">
          <for var="e" index="i" list="entries">
            <MenuItem key="{e.key}" label="{e.label}"/>
          </for>
        </box>
      </if>
    </control>
    <else>
      <control interactive="true" focusable="true" activatable="true" disabled="{disabled}" scale-x="{scale_x}" scale-y="{scale_y}" translate-x="{translate_x}" translate-y="{translate_y}" class="drop-down drop-down {open ? 'open'} {open ? 'morph-menu'} {show_items ? 'menu-layout'} {material} dd-morph {material == 'glass' ? 'dd-morph-glass' : 'dd-morph-solid'} {press ? 'pressed' : (hover ? 'hovered' : '')} {focused ? 'focused'} {disabled ? 'disabled'} {extra_class}">
        <if cond="!show_items">
          <box key="head" class="dd-head {open ? 'morphed'}">
            <if cond="icon">
              <box key="icon" icon="{icon}" class="dd-icon {material}"/>
            </if>
            <text key="label" text="{label_key ? tr(label_key) : label}" class="dd-label {material}"/>
            <box key="chevron" icon="{logical_open ? 'chevron-up' : 'chevron-down'}" class="dd-chevron {logical_open ? 'open'}"/>
          </box>
        </if>
        <if cond="show_items">
          <box key="menu-body" class="dd-menu-body">
            <for var="e" index="i" list="entries">
              <MenuItem key="{e.key}" label="{e.label}"/>
            </for>
          </box>
        </if>
      </control>
    </else>
  </if>
</component>

<component name="ComboBox" params="value">
  <control interactive="true" class="combo-box {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <text key="value" text="{value}" class="combo-value"/>
    <box key="chevron" icon="chevron-down" class="combo-chevron"/>
  </control>
</component>

<!-- 步进钮的 hover/press 基准是它们自己的 key（与 Rust 版一致：
     调用方按 "spin:up"/"spin:down" 查输入态）。 -->
<component name="SpinBox" params="value">
  <control interactive="true" class="spin-box {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <text key="value" text="{value}" class="spin-value"/>
    <!-- 上下按钮竖向叠在右端（Fluent NumberBox 的形态），不再并排悬空。 -->
    <box key="steps" class="spin-steps">
      <control key="spin:up" interactive="true" class="spin-step {press('spin:up') ? 'pressed' : (hover('spin:up') ? 'hovered' : '')}">
        <box key="icon" icon="chevron-up" class="spin-step-icon"/>
      </control>
      <control key="spin:down" interactive="true" class="spin-step {press('spin:down') ? 'pressed' : (hover('spin:down') ? 'hovered' : '')}">
        <box key="icon" icon="chevron-down" class="spin-step-icon"/>
      </control>
    </box>
  </control>
</component>

<!-- 8x2 色板：格子色在样式表 sw-0..15（源码发词）。 -->
<component name="ColorPicker" params="sel state">
  <box class="color-picker {state}">
    <box key="sw-row:0" class="swatch-row">
      <for var="i" list="range(8)">
        <box key="{'swatch:' + str(i)}" interactive="true" class="swatch {'sw-' + str(i)} {press('swatch:' + str(i)) ? 'pressed' : (hover('swatch:' + str(i)) ? 'hovered' : '')} {i == sel ? 'selected'}"/>
      </for>
    </box>
    <box key="sw-row:1" class="swatch-row">
      <for var="i" list="range(8)">
        <box key="{'swatch:' + str(i + 8)}" interactive="true" class="swatch {'sw-' + str(i + 8)} {press('swatch:' + str(i + 8)) ? 'pressed' : (hover('swatch:' + str(i + 8)) ? 'hovered' : '')} {i + 8 == sel ? 'selected'}"/>
      </for>
    </box>
  </box>
</component>

<component name="ListView" params="items sel">
  <box class="list-view">
    <for var="e" list="items">
      <control key="{e.id}" interactive="true" class="list-row {e.id == sel ? 'selected'} {press(e.id) ? 'pressed' : (hover(e.id) ? 'hovered' : '')}">
        <text key="label" text="{e.label}" class="{e.id == sel ? 'selected'} {press(e.id) ? 'pressed' : (hover(e.id) ? 'hovered' : '')} list-label"/>
      </control>
    </for>
  </box>
</component>

<!-- 定列宽静态表：数据格可点（选中是应用状态，控件只发 key）。 -->
<component name="TableView" params="headers rows">
  <box class="table-view">
    <box key="head" class="table-head-row">
      <for var="h" index="c" list="headers">
        <text key="{'th:' + str(c)}" text="{h}" class="table-head"/>
      </for>
    </box>
    <for var="row" index="r" list="rows">
      <box key="{'tr:' + str(r)}" class="table-row">
        <for var="cell" index="c" list="row.cells">
          <text key="{'td:' + str(r) + str(c)}" text="{cell}" interactive="true" class="table-cell {press('td:' + str(r) + str(c)) ? 'pressed' : (hover('td:' + str(r) + str(c)) ? 'hovered' : '')}"/>
        </for>
      </box>
    </for>
  </box>
</component>

<!-- 翻页点即翻页按钮（core 无拖拽手势）。 -->
<component name="SwipeView" params="pages idx">
  <box class="swipe-view">
    <box key="card" class="swipe-card">
      <for var="p" index="i" list="pages">
        <if cond="i == idx">
          <text key="title" text="{p.title}" class="swipe-title"/>
          <text key="desc" text="{p.desc}" class="swipe-desc"/>
        </if>
      </for>
    </box>
    <box key="pips" class="swipe-pips">
      <for var="p" index="i" list="pages">
        <box key="{'sw:' + str(i)}" interactive="true" class="swipe-pip {i == idx ? 'selected'} {press('sw:' + str(i)) ? 'pressed' : (hover('sw:' + str(i)) ? 'hovered' : '')}"/>
      </for>
    </box>
  </box>
</component>

<component name="Avatar" params="initials accent">
  <box class="avatar {accent ? 'accent'}">
    <text key="initials" text="{initials}" class="avatar-text {accent ? 'accent'}"/>
  </box>
</component>

<!-- RinUI `SettingItem.qml`：`clickable` 决定是否可点、并显示尾部箭头。 -->
<component name="SettingItem" params="icon title desc clickable">
  <box key="{key}" interactive="{clickable}" class="setting-item {clickable ? 'clickable' : ''}">
    <box key="icon" icon="{icon}" class="setting-icon"/>
    <box key="texts" class="setting-texts">
      <text key="title" text="{title}" class="setting-title"/>
      <text key="desc" text="{desc}" class="setting-desc"/>
    </box>
  </box>
</component>

<component name="SettingExpander" params="title desc expanded">
  <box class="setting-expander">
    <box key="{key}" interactive="true" class="setting-header">
      <box key="texts" class="setting-texts">
        <text key="title" text="{title}" class="setting-title"/>
        <text key="desc" text="{desc}" class="setting-desc"/>
      </box>
      <box key="chevron" icon="chevron-down" class="setting-chevron {expanded ? 'open'}"/>
    </box>
    <box key="content" collapsed="{!expanded}" class="setting-content">
      <children/>
    </box>
  </box>
</component>

<component name="AcrylicCard" params="">
  <box class="acrylic-card">
    <children/>
  </box>
</component>

<component name="CornerOverlay" params="radius">
  <box class="corner-overlay {radius}">
    <children/>
  </box>
</component>

<component name="Dialog" params="title text buttons">
  <box class="dialog">
    <text key="title" text="{title}" class="dialog-title"/>
    <text key="text" text="{text}" class="dialog-text"/>
    <box key="buttons" class="dialog-buttons">
      <for var="b" list="buttons">
        <Button key="{b.id}" label="{b.label}" variant="{b.primary ? 'accent' : 'standard'}"/>
      </for>
    </box>
  </box>
</component>

<!-- 日历：格子数据由宿主给（rec.day，负数 = 空格）；at(list, r*7+c) 分格。
     key 的两位零填充与 Rust 版 key 表逐串一致。 -->
<component name="DatePicker" params="heads cells rows sel">
  <box class="date-picker">
    <box key="heads" class="dp-heads">
      <for var="h" index="i" list="heads">
        <text key="{'dph:' + str(i)}" text="{h}" class="dp-head"/>
      </for>
    </box>
    <for var="r" list="range(rows)">
      <box key="{'dpr:' + str(r)}" class="dp-row">
        <for var="c" list="range(7)">
          <if cond="at(cells, r * 7 + c).day >= 0">
            <box key="{'dpc:' + str(r) + str(c)}" interactive="true" class="dp-cell {press('dpc:' + str(r) + str(c)) ? 'pressed' : (hover('dpc:' + str(r) + str(c)) ? 'hovered' : '')}">
              <box key="day" class="dp-day {at(cells, r * 7 + c).day == sel ? 'selected'}">
                <text key="label" text="{str(at(cells, r * 7 + c).day)}" class="dp-day-label {at(cells, r * 7 + c).day == sel ? 'selected'}"/>
              </box>
            </box>
            <else>
              <box key="{'dpc:' + str(r) + str(c)}" class="dp-cell"/>
            </else>
          </if>
        </for>
      </box>
    </for>
  </box>
</component>

<!-- 时/分两列：可见窗口由宿主给；选中项按文字比对（与 Rust 版一致）。 -->
<component name="TimePicker" params="hours hour minutes minute">
  <box class="time-picker">
    <box key="hours" class="tp-col">
      <for var="e" list="hours">
        <box key="{e.key}" interactive="true" class="tp-item {e.label == hour ? 'selected'} {press(e.key) ? 'pressed' : (hover(e.key) ? 'hovered' : '')}">
          <text key="label" text="{e.label}" class="tp-label {e.label == hour ? 'selected'}"/>
        </box>
      </for>
    </box>
    <box key="minutes" class="tp-col">
      <for var="e" list="minutes">
        <box key="{e.key}" interactive="true" class="tp-item {e.label == minute ? 'selected'} {press(e.key) ? 'pressed' : (hover(e.key) ? 'hovered' : '')}">
          <text key="label" text="{e.label}" class="tp-label {e.label == minute ? 'selected'}"/>
        </box>
      </for>
    </box>
  </box>
</component>

<!-- 单行输入框。children 槽位给 AutoSuggestBox 追加建议列表用
     （Rust 版 field.with_children([list]) 同一形态）。 -->
<component name="TextField" params="value placeholder cursor selection_begin selection_end scroll_x">
  <control interactive="true" focusable="true" class="text-field {focused ? 'focused'} {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <box key="fill:selection" translate-x="{selection_begin}" width="{selection_end - selection_begin}" class="selection {selection_begin != selection_end ? 'has-selection' : ''}"/>
    <!-- 文本本身按 scroll_x 横向平移：长文本不换行、溢出由 .text-field 的 overflow:hidden 裁掉。 -->
    <text key="text" translate-x="{scroll_x}" text="{value == '' ? placeholder : value}" class="field-text {value == '' ? 'placeholder'} {focused ? 'focused'}"/>
    <box key="cursor" translate-x="{cursor}" class="cursor {focused ? 'focused' : ''}"/>
    <if cond="value != ''">
      <control key="field:clear" interactive="true" class="field-clear {focused ? 'focused'} {hover ? 'hovered' : ''}">
        <box key="icon" icon="close" class="{focused ? 'focused'} {hover ? 'hovered' : ''} field-clear-icon"/>
      </control>
    </if>
    <children/>
  </control>
</component>

<component name="TextArea" params="text cursor_x cursor_y selection_x selection_y selection_w selection_h scroll_x scroll_y">
  <box translate-x="{scroll_x}" translate-y="{scroll_y}" class="text-area">
    <box key="fill:selection" translate-x="{selection_x}" translate-y="{selection_y}" width="{selection_w}" height="{selection_h}" class="selection {selection_w != 0 && selection_h != 0 ? 'has-selection' : ''}"/>
    <text key="area-text" text="{text}" class="area-text"/>
    <box key="cursor" translate-x="{cursor_x}" translate-y="{cursor_y}" class="cursor"/>
  </box>
</component>



<!-- ⚠ 忠实复刻 Rust 版的存量行为：`field.with_children([list])` 里
     with_children 是**替换**语义 —— 输入框自己的 text/clear 子节点被建议
     列表整个换掉。这里不修（改了就是行为变更），parity 按现状对照；
     要修请两侧同修并更新 parity 页。 -->
<component name="AutoSuggestBox" params="suggestions open sel">
  <control interactive="true" class="text-field {open ? 'focused'} {press ? 'pressed' : (hover ? 'hovered' : '')}">
    <if cond="open">
      <box key="suggestions" class="suggest-list">
        <SugRows suggestions="{suggestions}" sel="{sel}"/>
      </box>
      <else>
        <box key="suggestions" collapsed="true" class="suggest-list">
          <SugRows suggestions="{suggestions}" sel="{sel}"/>
        </box>
      </else>
    </if>
  </control>
</component>

<component name="SugRows" params="suggestions sel">
  <for var="s" index="i" list="suggestions">
    <box key="{'sug:' + str(i)}" class="suggest-row {i == sel ? 'selected'}">
      <text key="label" text="{s}" class="suggest-label"/>
    </box>
  </for>
</component>

<!-- 右键菜单（内联形态）：分隔线在项与项之间（i &gt; 0）。 -->
<component name="TextInputMenu" params="items">
  <box class="context-menu">
    <for var="item" index="i" list="items">
      <!-- Rust 的分隔线键表从 "msep:1" 开表、按下标取：i=1 → "msep:2"。 -->
      <if cond="i > 0">
        <box key="{'msep:' + str(i + 1)}" class="menu-separator"/>
      </if>
      <box key="{'mi:' + str(i)}" interactive="true" class="menu-item">
        <text key="label" text="{item}" class="menu-label"/>
      </box>
    </for>
  </box>
</component>


<!-- 滚动容器：视口盒子 + 内容盒子。
     scroll_x / scroll_y = 当前滚动偏移（正数 = 内容向上 / 向左移）。
     视口尺寸与 `overflow` 在 `.zstyle`（`.scroll-view`）；内容盒子不设尺寸 ——
     它的高度由内容量出来，那才是"内容比视口高多少"的真值。 -->
<component name="ScrollView" params="scroll_x scroll_y">
  <box interactive="true" scroll-offset-x="{scroll_x}" scroll-offset-y="{scroll_y}" class="scroll-view">
    <box key="content" class="scroll-view-content">
      <children/>
    </box>
  </box>
</component>

<!-- 滚动条：轨道 + 拇指。
     thumb_len = 拇指长度（DIP）；thumb_pos = 拇指在轨道上的起点（DIP）。
     拇指的长度与位置是**动态**的（内容多寡、滚到哪了），所以走宿主绑定；
     轨道的尺寸是静态的，住在 `.zstyle`。 -->
<component name="ScrollBar" params="thumb_len thumb_pos">
  <box interactive="true" class="scroll-bar">
    <box key="fill:scroll-thumb" interactive="true" height="{thumb_len}" translate-y="{thumb_pos}" class="scroll-thumb"/>
  </box>
</component>

<!-- 视频 / 摄像头画面：每帧外部纹理的显示面。
     `src` 是宿主通过 ExtContextHandle::submit_frame 提交的纹理 key（如 `video:main`）。
     控件本身不含采集/解码/时钟：它只声明「这块矩形画哪个 key」，帧从哪来由应用决定。
     texture 属性落在节点自身的 IMAGE_TEXTURE 上，绘制序为「背景 → 图像 → 子节点」，
     所以子节点将来可以叠 HUD 而不遮住画面。 -->
<component name="Video" params="src">
  <box key="video-frame" texture="{src}" class="video-frame"/>
</component>

<component name="Camera" params="src">
  <box key="camera-frame" texture="{src}" class="camera-frame"/>
</component>

<!-- 完整播放器：画面 + 控制条。
     状态值与派生几何由宿主从 `zephyra_ui::PlayerState` 喂进来；这里只声明结构。
     控制条挂在画面盒子的子节点上，绘制序「背景 → 图像 → 子节点」保证它盖在画面上。
     `fill:` key 是唯一允许写本地 width 的节点，所以拖动条的宽度走绑定值。 -->
<component name="VideoPlayer" params="src state label_key play_icon mute_icon fullscreen_icon seek_fill_w seek_thumb_x volume_fill_w volume_thumb_x volume_text time_text duration_text rate_text fullscreen">
  <box key="video-frame" texture="{src}" class="video-frame video-player {state} {fullscreen ? 'fullscreen'}">
    <text key="label" text="{tr(label_key)}" class="player-label"/>
    <box key="player-shade" class="player-shade"/>
    <box key="player-controls" class="player-controls">
      <control key="act:player-play-pause" interactive="true" focusable="true" activatable="true" class="button tool-button player-button">
        <box key="icon" icon="{play_icon}" class="tool-icon"/>
      </control>
      <text key="player-time" text="{time_text + ' / ' + duration_text}" class="player-time"/>
      <control key="act:player-seek" interactive="true" focusable="true" activatable="true" class="player-seek">
        <box key="track" class="player-seek-track">
          <box key="fill:player-seek" width="{seek_fill_w}" class="player-seek-fill"/>
          <box key="thumb:seek" translate-x="{seek_thumb_x}" class="player-seek-thumb"/>
        </box>
      </control>
      <control key="act:player-mute" interactive="true" focusable="true" activatable="true" class="button tool-button player-button">
        <box key="icon" icon="{mute_icon}" class="tool-icon"/>
      </control>
      <control key="act:player-volume" interactive="true" focusable="true" activatable="true" class="player-volume">
        <box key="track" class="player-volume-track">
          <box key="fill:player-volume" width="{volume_fill_w}" class="player-volume-fill"/>
          <box key="thumb:volume" translate-x="{volume_thumb_x}" class="player-volume-thumb"/>
        </box>
        <text key="player-volume-value" text="{volume_text}" class="player-volume-value"/>
      </control>
      <control key="act:player-rate" interactive="true" focusable="true" activatable="true" class="button player-rate">
        <text key="label" text="{rate_text}" class="player-rate-label"/>
      </control>
      <control key="act:player-fullscreen" interactive="true" focusable="true" activatable="true" class="button tool-button player-button">
        <box key="icon" icon="{fullscreen_icon}" class="tool-icon"/>
      </control>
    </box>
    <if cond="state == 'buffering'">
      <box key="player-buffering" class="player-buffering"/>
    </if>
  </box>
</component>
