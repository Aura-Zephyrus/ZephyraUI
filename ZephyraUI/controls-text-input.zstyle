/* TextField、TextArea、ScrollableTextArea、AutoSuggestBox、TextInputMenu
 * —— Apple HIG 度量。
 *
 * 输入控件高 36px，圆角 8px。
 */

/* ---- TextField ---- */

control.text-field {
    direction: horizontal;
    main-align: space-between;
    cross-align: center;
    spacing: 10px;
    padding: 10px;
    height: 36px;
    width: 240px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    background: @control_fill;
    border-width: 1px;
    border-color: @control_border;
    /* 长文本不换行：溢出裁到输入框内，由 text_field_scroll 平移保持光标可见。 */
    overflow: hidden;
}

control.text-field.hovered {
    background: @control_fill_hover;
}

control.text-field.focused {
    border-color: @accent_fill;
    border-width: 2px;
}

text.field-text {
    text-size: 15px;
    text-color: @content;
}

text.field-text.placeholder {
    text-color: @content_disabled;
}

/* 选区高亮块：脱流定位，x/宽度由宿主按字形步进换算成 DIP 绑定。
 *
 * ⚠ 高度必须等于**文本行高**（18px），不是输入框高度（36px）—— 否则蓝色块
 *   上下各多出一截，比文字大一圈（截图里是一根高 36px 的蓝条）。和光标
 *   `box.cursor` 用同一个高度口径。 */
box.selection {
    position: parent;
    anchor: top-left;
    height: 18px;
    background: @accent_fill;
    opacity: 0.3;
    corner-radius: 2px;
    corner-shape: superellipse(1.5);
}

box.selection.has-selection {
    opacity: 0.5;
}

/* 光标：2px 竖条，脱流定位，x 由宿主按光标字节下标换算成 DIP 绑定。
 *
 * ⚠ 高度必须等于**文本行高**（18px），不是输入框高度（36px）。脱流锚点是
 *   内容原点（已含 padding），拿 36px 会从文字顶端一路画到框外 9px —— 实测
 *   在文本框下方的「全选 / 复制 / 粘贴」按钮上留一道白线。 */
box.cursor {
    position: parent;
    anchor: top-left;
    width: 2px;
    height: 18px;
    background: @content;
}

box.cursor.focused {
    opacity: 1;
}

control.field-clear {
    width: 28px;
    height: 24px;
    corner-radius: 9.6px;
    corner-shape: superellipse(1.5);
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: transparent;
}

control.field-clear.hovered {
    background: @control_secondary;
}

box.field-clear-icon {
    width: 14px;
    height: 14px;
    icon-color: @content_secondary;
}

/* ---- TextArea ---- */

box.text-area {
    direction: vertical;
    spacing: 6px;
    padding: 14px;
    width: 340px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    background: @control_fill;
    border-width: 1px;
    border-color: @control_border;
}

text.area-line {
    text-size: 15px;
    text-color: @content;
}

box.scroll-area {
    direction: horizontal;
    spacing: 10px;
    cross-align: stretch;
}

box.scrollbar {
    width: 7px;
    corner-radius: 158.4px;
    corner-shape: superellipse(1.5);
    background: @control_fill;
    direction: vertical;
    main-align: start;
    padding: 0px;
}

box.scroll-thumb {
    width: 7px;
    corner-radius: 158.4px;
    corner-shape: superellipse(1.5);
    background: @control_strong;
}

/* ---- AutoSuggestBox ---- */

box.suggest-list {
    direction: vertical;
    spacing: 0px;
    padding: 6px;
    cross-align: stretch;
    corner-radius: 16px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

box.suggest-row {
    height: 34px;
    padding: 10px;
    corner-radius: 9.6px;
    corner-shape: superellipse(1.5);
    direction: horizontal;
    main-align: start;
    cross-align: center;
    background: transparent;
}

box.suggest-row.selected {
    background: @control_secondary;
}

text.suggest-label {
    text-size: 14px;
    text-color: @content;
}

/* ---- TextInputMenu ---- */

box.context-menu {
    direction: vertical;
    spacing: 0px;
    padding: 6px;
    width: 200px;
    cross-align: stretch;
    corner-radius: 16px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

box.menu-item {
    height: 34px;
    padding: 10px;
    corner-radius: 9.6px;
    corner-shape: superellipse(1.5);
    direction: horizontal;
    main-align: start;
    cross-align: center;
    background: transparent;
}

box.menu-item.hovered {
    background: @control_secondary;
}
