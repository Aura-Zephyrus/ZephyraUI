/* NavigationSubItem、SelectorBar、ErrorPage —— Apple HIG 度量。 */

/* ---- NavigationSubItem ---- */

control.nav-sub {
    direction: horizontal;
    cross-align: center;
    spacing: 14px;
    height: 44px;
    padding: 10px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    background: transparent;
}

control.nav-sub.selected {
    background: @control_secondary;
}

control.nav-sub.hovered {
    background: @control_secondary;
}

box.nav-indent {
    width: 22px;
    height: 1px;
    background: transparent;
}

box.sub-icon {
    width: 18px;
    height: 18px;
    icon-color: @content_secondary;
}

box.sub-icon.selected {
    icon-color: @accent_fill;
}

text.sub-label {
    text-size: 14px;
    text-color: @content_secondary;
}

text.sub-label.selected {
    text-color: @content;
}

/* ---- SelectorBar ---- */

box.selector-bar {
    direction: horizontal;
    spacing: 6px;
    cross-align: center;
}

/* 已点过一次：轻微降透明度，让「点了已选中项」在树里也有状态变化。 */
box.selector-bar.tapped {
    opacity: 0.98;
}

control.selector-item {
    height: 34px;
    padding: 12px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: transparent;
    border-width: 1px;
    border-color: transparent;
}

control.selector-item.hovered {
    background: @control_secondary;
}

control.selector-item.selected {
    background: @control_fill;
    border-color: @control_border;
}

text.selector-label {
    text-size: 14px;
    text-color: @content_secondary;
}

text.selector-label.selected {
    text-color: @content;
}

/* ---- ErrorPage ---- */

box.error-page {
    direction: vertical;
    main-align: center;
    cross-align: center;
    spacing: 10px;
    padding: 28px;
}

box.error-gap {
    height: 68px;
}

box.error-icon {
    width: 56px;
    height: 56px;
    icon-color: @critical;
}

text.error-title {
    text-size: 17px;
    text-color: @content;
}

text.error-message {
    text-size: 15px;
    text-color: @content_secondary;
}
