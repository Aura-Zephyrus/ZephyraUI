/* Button、ToolButton、PillButton —— Apple HIG 度量。
 *
 * 圆角 8px（HIG 连续圆角），按钮高 36px，pill 保持全圆角。
 * 状态链：variant 规则在前，hovered/pressed 在后（后者赢）。
 */

/* ---- Button ---- */

Control.button {
    direction: horizontal;
    main-align: center;
    cross-align: center;
    spacing: 10px;
    padding: 10px;
    corner-radius: 8px;
    height: 36px;
    border-width: 1px;
}

Control.button.standard {
    background: @control_fill;
    border-color: @control_border;
}

Control.button.accent {
    background: @accent_fill;
    border-color: @accent_fill;
}

Control.button.subtle {
    background: transparent;
    border-color: transparent;
}

/* 状态规则：只碰 border 这类与变体无关的量；background 全部走 3 名交叉规则。 */
Control.button.hovered {
    border-color: @control_border_strong;
}

Control.button.standard.hovered {
    background: @control_fill_hover;
}

Control.button.standard.pressed {
    background: @control_fill_pressed;
}

Control.button.subtle.hovered {
    background: @control_secondary;
}

Control.button.subtle.pressed {
    background: @control_tertiary;
}

/* accent 的三个交叉态都保持强调底。 */
Control.button.accent.hovered {
    background: @accent_fill;
}

Control.button.accent.pressed {
    background: @accent_fill;
}

/* 焦点环：键盘 Tab/点击把焦点停在这颗按钮上时描一圈。
 *
 * 与 text-field 的 `.focused` 同一套度量（`@focus_ring` + 2px）。焦点环与
 * hovered/pressed 是**正交**的两维——一个按钮可以既被悬停又有焦点，所以
 * `focused` 不进 pressed/hovered 那条三元链，而是独立的一条规则。 */
Control.button.focused {
    border-color: @focus_ring;
    border-width: 2px;
}

/* ---- 材质（material）----
 *
 * 材质与 background **正交**：
 * - `material:` 决定「透过按钮看**背后**怎么处理」（背后模糊 / 背后折射 / 不动）；
 * - `background:` 决定「按钮自己画什么」（实色 / 半透明 / 透明）。
 *
 * 未声明 `material` 的按钮 = 纯色（默认，只靠 background）。材质名只写一个词，
 * 参数（模糊 σ / 折射率…）藏在 core `filter::Material` 的默认值里 —— 见
 * `docs/todo/control-capability-audit.md` 与 `props::MATERIAL` 的文档。
 *
 * 用法：`<Button material="frosted"/>` / `<Button material="glass"/>`。
 */

/* 模糊透明（磨砂玻璃）：半透明填充 + 背后高斯模糊。
 *
 * 半透明填充让按钮「能看见背后」，`material: frosted` 让背后「被糊掉」——
 * 两者合起来才是磨砂玻璃。只写 material 不写 background 会看见**清晰**的
 * 背后（只是没被糊），那是「透明按钮」不是「磨砂按钮」。
 *
 * `material-params` 是**独立**于 `material` 的参数覆盖：这里把 σ 调到 10px
 * （默认 6px）—— 磨得更狠一点。不写它就吃默认值。 */
Control.button.frosted {
    background: @surface_alt_translucent;
    material: frosted;
    material-params: 10;
}

Control.button.frosted.hovered {
    background: @control_fill_hover;
}

/* 液态玻璃：不写 background（默认透明）+ 背后折射。
 *
 * 液态玻璃要的是「透过按钮看见**被弯曲**的背景」，所以填充必须完全透明 ——
 * 不写 `background` 即默认透明（core 读不到 background 时按 `rgba(0,0,0,0)`），
 * 不必显式写 `background: transparent`。
 *
 * `material-params` 独立于 `material`：顺序 `<厚度> <倒角> <色散> <折射率>`，
 * 这里调成厚 26px（默认 20）、倒角 18px（默认 16）、无仍色散、IOR 1.5。 */
Control.button.glass {
    material: glass;
    material-params: 26 18 0 1.5;
    border-color: #ffffffb3;
}

Text.btn-label {
    text-size: 15px;
    text-color: @content;
}

Text.btn-label.accent {
    text-color: @on_accent_fill;
}

Container.btn-icon {
    width: 18px;
    height: 18px;
    icon-color: @content_secondary;
}

Container.btn-icon.hovered {
    icon-color: @content;
}

Container.btn-icon.accent {
    icon-color: @on_accent_fill;
}

/* ---- ToolButton（44×44） ---- */

Control.tool-button {
    width: 44px;
    height: 44px;
    corner-radius: 10px;
    padding: 10px;
    direction: horizontal;
    main-align: center;
    cross-align: center;
    background: @control_fill;
    border-width: 1px;
    border-color: @control_border;
}

Control.tool-button.hovered {
    background: @control_fill_hover;
    border-color: @control_border_strong;
}

Control.tool-button.pressed {
    background: @control_fill_pressed;
}

Container.tool-icon {
    width: 22px;
    height: 22px;
    icon-color: @content;
}

/* ---- PillButton ---- */

Control.pill {
    direction: horizontal;
    main-align: center;
    cross-align: center;
    spacing: 10px;
    padding: 12px;
    height: 36px;
    corner-radius: 99px;
    background: @control_fill;
    border-width: 1px;
    border-color: @control_border;
}

Control.pill.checked {
    background: @accent_fill;
    border-color: @accent_fill;
}

Control.pill.hovered {
    background: @control_fill_hover;
}

Control.pill.checked.hovered {
    background: @accent_fill;
}

Control.pill.pressed {
    background: @control_fill_pressed;
}

Control.pill.checked.pressed {
    background: @accent_fill;
}

Text.pill-label {
    text-size: 14px;
    text-color: @content;
}

Text.pill-label.checked {
    text-color: @on_accent_fill;
}

Container.pill-icon {
    width: 18px;
    height: 18px;
    icon-color: @content_secondary;
}

Container.pill-icon.checked {
    icon-color: @on_accent_fill;
}
