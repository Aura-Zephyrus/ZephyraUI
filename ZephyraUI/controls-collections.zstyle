/* ListView、TableView、SwipeView、Avatar、SettingItem、SettingExpander
 * —— Apple HIG 度量。
 *
 * 列表项高 44px（HIG 最小触控目标），圆角 8px。
 */

/* ---- ListView ---- */

box.list-view {
    direction: vertical;
    spacing: 4px;
    padding: 6px;
    width: 280px;
    cross-align: stretch;
    corner-radius: 16px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

control.list-row {
    height: 44px;
    padding: 10px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    direction: horizontal;
    main-align: start;
    cross-align: center;
    background: transparent;
}

control.list-row.hovered {
    background: @control_secondary;
}

control.list-row.selected {
    background: @control_fill;
    border-width: 1px;
    border-color: @control_border;
}

text.list-label {
    text-size: 15px;
    text-color: @content;
}

/* ---- TableView ---- */

box.table-view {
    direction: vertical;
    spacing: 0px;
    width: 440px;
    corner-radius: 16px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

box.table-head-row {
    direction: horizontal;
    spacing: 14px;
    height: 40px;
    cross-align: center;
    padding: 14px;
    background: @surface_alt;
}

text.table-head {
    text-size: 13px;
    text-color: @content_secondary;
}

box.table-row {
    direction: horizontal;
    spacing: 14px;
    height: 44px;
    cross-align: center;
    padding: 14px;
    border-width: 1px;
    border-color: @divider;
}

text.table-cell {
    text-size: 14px;
    text-color: @content;
}

text.table-cell.hovered {
    background: @control_secondary;
    corner-radius: 6.4px;
    corner-shape: superellipse(1.5);
}

text.table-cell.pressed {
    background: @control_tertiary;
    corner-radius: 6.4px;
    corner-shape: superellipse(1.5);
}

/* ---- SwipeView ---- */

box.swipe-view {
    direction: vertical;
    spacing: 14px;
    width: 340px;
}

box.swipe-card {
    direction: vertical;
    spacing: 10px;
    padding: 18px;
    height: 110px;
    corner-radius: 19.2px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

text.swipe-title {
    text-size: 17px;
    text-color: @content;
}

text.swipe-desc {
    text-size: 14px;
    text-color: @content_secondary;
}

box.swipe-pips {
    direction: horizontal;
    spacing: 8px;
    main-align: center;
}

box.swipe-pip {
    width: 7px;
    height: 7px;
    corner-radius: 158.4px;
    corner-shape: superellipse(1.5);
    background: @control_strong;
}

box.swipe-pip.hovered {
    background: @accent_fill;
}

box.swipe-pip.pressed {
    background: @accent_fill;
    opacity: 0.7;
}

box.swipe-pip.selected {
    width: 18px;
    background: @accent_fill;
}

/* ---- Avatar ---- */

box.avatar {
    width: 36px;
    height: 36px;
    corner-radius: 158.4px;
    corner-shape: superellipse(1.5);
    background: @control_strong;
    direction: horizontal;
    main-align: center;
    cross-align: center;
}

box.avatar.accent {
    background: @accent_fill;
}

text.avatar-text {
    text-size: 13px;
    text-color: @content;
}

text.avatar-text.accent {
    text-color: #ffffff;
}

/* ---- SettingItem / SettingExpander ---- */

box.setting-item {
    direction: horizontal;
    cross-align: center;
    spacing: 14px;
    padding: 14px;
    corner-radius: 12.8px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
    height: 60px;
    width: 440px;
}

box.setting-icon {
    width: 22px;
    height: 22px;
    icon-color: @accent_fill;
}

box.setting-expander {
    direction: vertical;
    width: 440px;
    corner-radius: 16px;
    corner-shape: superellipse(1.5);
    background: @card;
    border-width: 1px;
    border-color: @card_border;
}

box.setting-header {
    direction: horizontal;
    main-align: space-between;
    cross-align: center;
    height: 60px;
    padding: 14px;
}

box.setting-chevron {
    width: 14px;
    height: 14px;
    icon-color: @content_secondary;
}

box.setting-chevron.open {
    icon-color: @content;
}

box.setting-content {
    direction: vertical;
    spacing: 10px;
    padding: 14px;
}
